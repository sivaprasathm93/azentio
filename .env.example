# Copy to .env and change every value. Never commit .env.
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-db

# Demo users (HTTP Basic). Passwords are bcrypt-hashed in memory at startup.
SENTINEL_ANALYST_USER=analyst
SENTINEL_ANALYST_PASSWORD=change-me-analyst
SENTINEL_SUPERVISOR_USER=supervisor
SENTINEL_SUPERVISOR_PASSWORD=change-me-supervisor
SENTINEL_ADMIN_USER=admin
SENTINEL_ADMIN_PASSWORD=change-me-admin

# Detection worker threads used for bulk loads
SENTINEL_DETECTION_THREADS=8

# Frontend has no sign-in screen: nginx sends this Basic credential to the backend. base64 of "user:password".
# Use the admin account if the UI should be able to edit rules.  printf '%s' 'admin:<password>' | base64
FRONTEND_BASIC_AUTH=
