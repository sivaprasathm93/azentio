# "mock" runs entirely in the browser with the seeded demo data (no backend needed).
# "live" talks to the Spring Boot API at /api/v1 (proxied to VITE_BACKEND_URL in dev, by nginx in Docker).
VITE_API_MODE=mock
VITE_BACKEND_URL=http://localhost:8080

# There is no sign-in screen. In live mode the dev proxy authenticates to the backend as this service account.
# BACKEND_* are read by vite.config.ts only and are never exposed to the browser bundle.
# Use the admin account if this instance should be able to edit rules.
BACKEND_USER=analyst
BACKEND_PASSWORD=
# Public name of that account; the UI uses it to recognise "my" alerts (must equal BACKEND_USER).
VITE_API_USER=analyst

# STOMP endpoint (SockJS). Live mode falls back to polling if the broker is not reachable.
VITE_WS_PATH=/ws
VITE_ALERT_TOPIC=/topic/alerts
